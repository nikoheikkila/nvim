# Release packaging allowlist (rsync merge-filter rules; see the "Package artifact"
# step in .github/workflows/ci.yml). Order matters: most-specific rules first, the
# catch-all exclude last. Everything not explicitly included here is dropped from the
# release tarball — add new rules here, don't rely on the default.

+ /.markdownlint.jsonc
+ /.vale.ini
+ /LICENSE
+ /README.md
+ /config.yml
+ /init.lua
+ /lazy-lock.json
+ /screenshot.png
+ /theme.yml
+ /docs/***
+ /lua/***
- *
